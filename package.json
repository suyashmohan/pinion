{
  "name": "pinion",
  "version": "0.1.0",
  "private": true,
  "description": "Single-user web GUI for the Pi coding agent (JSON-RPC mode)",
  "license": "MIT",
  "author": "Suyash Mohan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suyashmohan/pinion.git"
  },
  "homepage": "https://github.com/suyashmohan/pinion#readme",
  "bugs": {
    "url": "https://github.com/suyashmohan/pinion/issues"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "web-ui",
    "nextjs",
    "bun",
    "sqlite"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun scripts/next.ts dev",
    "build": "NODE_ENV=production bun --bun next build",
    "start": "bun scripts/next.ts start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun test && tsc --noEmit && eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.545.0",
    "nanoid": "^5.1.5",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
