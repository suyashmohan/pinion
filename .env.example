# --- Database ---------------------------------------------------------------
# SQLite file used by drizzle through bun:sqlite. Relative paths resolve from
# process.cwd(). The parent directory must already exist.
DATABASE_URL="file:./data/pinion.db"

# --- Pi agent ---------------------------------------------------------------
# Absolute path (or bare name on PATH) for the pi binary that serves --mode rpc.
PI_BINARY="pi"
# Default working directory spawned pi processes run in (where read/write/bash
# tools operate). Defaults to process.cwd() when unset.
# PI_DEFAULT_CWD="/Users/you/projects"
# Extra default args for every `pi --mode rpc` spawn (space-separated),
# e.g. "--provider google".
# PI_EXTRA_ARGS=""
# Timeout for RPC request/response round-trips in ms.
# PI_RPC_TIMEOUT_MS="120000"
# Idle time after which an unused pi process is reaped (transparent respawn on
# next use). Explicit 0 disables reaping.
# PI_IDLE_TIMEOUT_MS="900000"
# Soft cap on concurrent pi processes (LRU idle eviction; streaming sessions
# are never evicted). 0 = unlimited.
# PI_MAX_PI_PROCESSES="10"

# --- Provider credentials ---------------------------------------------------
# pi reads provider API keys from the environment. Keys set here reach both a
# bare-metal `bun run start` and the Docker container — docker-compose.yml
# loads this file with `env_file`, so nothing secret needs to live in YAML.
# Uncomment the provider(s) you use; full list in pi's docs/providers.md.
# DEEPSEEK_API_KEY=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""

# --- Web server -------------------------------------------------------------
# Bind address. Defaults to 127.0.0.1 (loopback only). Set to 0.0.0.0 to reach
# Pinion from other devices on your LAN — and read the security section of the
# README first: Pinion can run shell commands as your user.
# PINION_HOST="127.0.0.1"
# PINION_PORT="3000"

# Host project folder bind-mounted at /workspace in Docker (default
# ./workspace). Also used as PI_DEFAULT_CWD inside the container.
# PINION_WORKSPACE="/Users/you/projects"

# Hostnames accepted in the Host header (comma-separated; loopback names are
# always accepted). Add the address you actually browse from, e.g. your LAN IP
# or a Tailscale name. Requests with any other Host are rejected with 403 —
# this is what stops DNS-rebinding attacks. Only needed for LAN access.
# PINION_ALLOWED_HOSTS="192.168.1.50"

# Optional shared secret. When set, every request must carry the cookie minted
# by opening http://<host>:<port>/?token=YOUR_TOKEN once. Recommended if you
# bind beyond loopback or put Pinion behind a tunnel.
# PINION_TOKEN=""

# Extra origins allowed to reach Next.js dev resources (HMR) from LAN devices
# while running `bun run dev` (only relevant in dev).
# PINION_ALLOWED_DEV_ORIGINS="192.168.1.50"
